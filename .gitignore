# The compiled binary (built with `make build` / `go build -o umbra`).
/umbra
umbra-*-*        # cross-compiled release artifacts (umbra-linux-amd64, …)

# Go build / test artifacts
*.exe
*.test
*.out
coverage.out

# ~/.umbra lives outside the repo — never commit app state or the Caddyfile.
# No secrets, tokens, or ACME account keys ever belong in this repo.
.env

.DS_Store
*.log
